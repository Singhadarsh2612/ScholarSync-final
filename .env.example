# =============================================================================
# ScholarSync — environment template
#
#   cp .env.example .env    then fill in the values below.
#
# Nothing here has a working default that costs money; the app starts with
# blanks and degrades (no LLM, no voice, no persistence) rather than crashing.
# Each variable notes which file reads it.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Azure OpenAI — chat models  (REQUIRED for the agent and the interviewer)
# -----------------------------------------------------------------------------
# The hub deliberately splits work across three deployments so one key's rate
# limit cannot stall everything. See chatbot/llm.py for the role split.
#
# If you only have ONE Azure OpenAI resource, fill in AZURE_OPENAI_ENDPOINT and
# AZURE_OPENAI_API_KEY and leave the MINI_2_* / GPT4O_* endpoint and key blank:
# azure_env.py falls back to the shared pair, so one resource serves all three
# roles. You still need each role's DEPLOYMENT name to match a real deployment.
#
# Endpoint format: https://<resource-name>.openai.azure.com/
# Get keys from: Azure Portal -> your Azure OpenAI resource -> Keys and Endpoint
#
# Deployment names are what YOU named the model when deploying it in Azure AI
# Foundry, NOT the model id. A name that does not exist in your resource fails
# at request time with `DeploymentNotFound`, so list yours first:
#
#     python azure_env.py          # shows what currently resolves
#
# Accepted aliases (first non-empty wins) are declared in azure_env.py, so an
# existing .env using other spellings keeps working:
#   MINI_2_*                <- GPT41MINI_*
#   DEPLOYMENT_NAME         <- GPT4O_MINI_DEPLOYMENT
#   AZURE_SEARCH_ADMIN_KEY  <- AZURE_SEARCH_API_KEY / AZURE_SEARCH_KEY
#   AZURE_EMBEDDING_*       <- EMBEDDING_DEPLOYMENT, else the shared pair

# Key 1 -> gpt-4o-mini. Used by ComplexityAnalyzer, SimpleRetriever,
# analysis_api.py, assignment_solver.py, and the whole interview service.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
DEPLOYMENT_NAME=gpt-4o-mini

# Key 2 -> gpt-4o-mini. Used by Explorers, FitnessEval, Exploiter,
# PresentationAgent, Critic.  (chatbot/llm.py)
MINI_2_ENDPOINT=
MINI_2_API_KEY=
MINI_2_DEPLOYMENT=gpt-4o-mini

# Key 3 -> gpt-4o. Used by the Planner only.  (chatbot/llm.py)
GPT4O_ENDPOINT=
GPT4O_API_KEY=
GPT4O_DEPLOYMENT=gpt-4o


# -----------------------------------------------------------------------------
# 2. Azure OpenAI — embeddings  (REQUIRED for assignment RAG + resume parsing)
# -----------------------------------------------------------------------------
# Deploy a text-embedding-3-small model. Read by assignment_solver.py and
# interview/cv_parser.py.
#
# This is a SEPARATE deployment from the chat models — having gpt-4o deployed
# does not give you embeddings. Without it, assignment solving and resume
# parsing fail with `DeploymentNotFound` while everything else works.
#
# Endpoint/key may be left blank to reuse AZURE_OPENAI_* above.
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-02-01


# -----------------------------------------------------------------------------
# 3. Azure AI Search  (REQUIRED for assignment solving / document Q&A)
# -----------------------------------------------------------------------------
# Create an "Azure AI Search" resource. The index is created on first use.
# Read by assignment_solver.py.
AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_API_KEY is also accepted as a name for this.
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX_NAME=scholarsync-docs


# -----------------------------------------------------------------------------
# 4. Azure Speech  (REQUIRED for the interviewer to speak and listen)
# -----------------------------------------------------------------------------
# Create a "Speech service" resource. Set REGION (e.g. centralindia, eastus);
# only set ENDPOINT instead if you use a custom/private endpoint.
# Read by interview/app/services/speech_service.py.
# Without these, interviews still run but stay text-only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=


# -----------------------------------------------------------------------------
# 5. Databases
# -----------------------------------------------------------------------------
# WHAT LIVES WHERE
#   Postgres  scholarsync   agent conversation history (LangGraph checkpoints:
#                           checkpoints, checkpoint_blobs, checkpoint_writes)
#   Mongo     $DB_NAME      interview sessions, transcripts, scores
#   Mongo     scholarsync_chat  expert-chat rooms + messages (owned by
#                           expert-chat/, configured in expert-chat/.env)
#
# Both are managed, hosted instances (no local Postgres/Mongo containers in
# Docker Compose) — the same DATABASE_URL / MONGO_URI works locally and under
# Compose, since there's no container hostname to swap in.

# ── Postgres — agent chat history ────────────────────────────────────────────
# Read by chatbot/config.py. If unset or unreachable the hub falls back to an
# in-memory checkpointer and threads are lost on restart (it logs which one it
# chose at startup).
#
# A hosted cluster (Neon, Supabase, Azure Database for PostgreSQL, RDS) works
# unchanged — just point this at it. Managed providers require TLS, so append
# ?sslmode=require:
#   postgresql://user:pass@ep-xxx.aws.neon.tech/scholarsync?sslmode=require
# Percent-encode any @ : / ? # in the password, or the URL will not parse.
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/scholarsync?sslmode=require

# ── MongoDB — interview sessions ─────────────────────────────────────────────
# Read by interview/app/services/mongo_services.py.
#
# MongoDB Atlas. Use the SRV form and keep the database name in DB_NAME rather
# than in the URI:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Two requirements for Atlas:
#   1. dnspython must be installed — `pymongo[srv]` in requirements.txt covers
#      it. Without it an SRV URI fails at connect time, not at install time.
#   2. Add your IP (or 0.0.0.0/0) to the cluster's Network Access list.
# Point expert-chat/.env's MONGO_URI at the same cluster to move chat too; it
# needs the database name IN the URI (…mongodb.net/scholarsync_chat).
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=scholar_sync

# How long to wait for Mongo before giving up (ms). Keep this low so an
# outage degrades fast instead of hanging every request.
MONGO_TIMEOUT_MS=3000

# Set to true ONLY for a cluster whose TLS certificate this host cannot
# verify. It disables certificate validation.
# MONGO_ALLOW_INVALID_CERTS=false


# -----------------------------------------------------------------------------
# 6. Agent tools
# -----------------------------------------------------------------------------
# Tavily web search — free tier at https://tavily.com
# Read by chatbot/tools.py and the MCP web_search tool.
TAVILY_API_KEY=

# Google Calendar. Create a service account in Google Cloud, enable the
# Calendar API, download the JSON key, and put the JSON here as a single line
# (or a path to the file, depending on your deployment).
# Read by chatbot/mcp_server/calendar_auth.py.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gmail app password for the send_email tool (requires 2FA on the account:
# Google Account -> Security -> App passwords). Paste it without spaces.
# Read by chatbot/mcp_server/config.py.
#
# GMAIL_SENDER is the account these are for, and must match the account the
# app password was generated on. It defaults to ADMIN_EMAIL when unset.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=


# -----------------------------------------------------------------------------
# 7. Service URLs  (defaults are correct for local development)
# -----------------------------------------------------------------------------
# All read by endpoints.py, which is the single source of truth for these.

# MCP tool server. Under Docker Compose this is http://mcp:8002
MCP_URL=http://127.0.0.1:8002

# Expert-chat service (the MERN app in expert-chat/).
# Under Docker Compose this is http://chat-api:5000
CHAT_API_URL=http://localhost:5000
CHAT_STUDENT_ID=test-user-123

# This deployment's own public base URL, used only to build user-facing links.
PUBLIC_BASE_URL=http://localhost:8000

# Where the interview React app is served from. The agent hands students
# links here (e.g. http://localhost:3001/interview/3).
INTERVIEW_UI_URL=http://localhost:3001


# -----------------------------------------------------------------------------
# 8. Student portals — the project's data layer (both are live)
# -----------------------------------------------------------------------------
# Override only if you host your own portal. Two portals, two student records.
STUDENT_PORTAL_2_URL=https://student-portal-2-gh1j.onrender.com
STUDENT_PORTAL_3_URL=https://student-portal-3-tos6.onrender.com
STUDENT_ID=69ad240e7352e15b1e37b844
STUDENT_ID_2=69abdbea843e1db183a2b20f


# -----------------------------------------------------------------------------
# 9. Hub sign-in
# -----------------------------------------------------------------------------
# Guards the dashboard at /auth/login. CHANGE THESE — the old defaults were
# hardcoded in server.py and are public in this repository's history.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 10. Expert-chat service secret  (REQUIRED by docker compose)
# -----------------------------------------------------------------------------
# The chat backend refuses to boot without this, and docker-compose.yml reads
# it from here. Generate one with:  openssl rand -hex 32
JWT_SECRET=


# -----------------------------------------------------------------------------
# 11. Optional: LangSmith tracing
# -----------------------------------------------------------------------------
# Every agent response, graph node, LLM call and tool call is traced to
# LangSmith when a key is set. Without one, observability/ is a no-op:
# decorators pass through and nothing is uploaded.
#
# LANGSMITH_API_KEY is the only credential required.
#   smith.langchain.com -> Settings -> API keys -> Create API key
#   Free tier covers personal use. Keys look like lsv2_pt_...
# The older LANGCHAIN_API_KEY / LANGCHAIN_PROJECT spellings are also accepted.
#
#   python -m observability.status     # confirm the key works
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ScholarSync

# LangGraph and LangChain trace graph nodes and LLM calls natively once a key
# is set, so wrapping them again nests a duplicate span around every one. Leave
# these off unless you specifically want the trimmed state snapshots and
# normalised token metadata instead. The root request span (status, tools
# called, latency) and the tool spans are always emitted -- LangChain cannot see
# the plain Python functions behind _call_tool.
OBS_WRAP_NODES=false
OBS_WRAP_LLM=false

# false = record latency, token counts and errors but not prompt/response text.
OBS_CAPTURE_CONTENT=true

# Per-field truncation in traces.
OBS_MAX_FIELD_CHARS=4000

# Deployment used by the LLM-as-judge in evaluation/. Defaults to
# GPT4O_DEPLOYMENT; scoring is separate from the agent's own model so it does
# not consume the same rate limit.
# EVAL_JUDGE_DEPLOYMENT=gpt-4o
