# ── ScholarSync expert-chat backend ──

# Port this API + Socket.IO server listens on.
PORT=5000

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/scholarsync_chat

# REQUIRED. The server refuses to boot without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# How long issued expert tokens stay valid.
JWT_EXPIRES_IN=30d

# Where the chat React app is served from.
# Used for CORS, Socket.IO origin, and user-facing chat links.
CLIENT_URL=http://localhost:3000

# This service's own public base URL, used to build absolute upload links.
SERVER_URL=http://localhost:5000

NODE_ENV=development
