# Python
__pycache__/
*.pyc

# Virtual environment
venv/

# Environment variables
# `.env` alone matches only that exact name, so a `.env.bak` / `.env.local` /
# `.env.production` would have been tracked with real keys in it. Ignore every
# variant and re-include the documented template.
.env
.env.*
!.env.example

# Google service-account private key, read by
# chatbot/mcp_server/calendar_auth.py when GOOGLE_SERVICE_ACCOUNT_JSON is unset.
service-account.json
**/service-account.json

# Node
node_modules/

# VS Code
.vscode/

# Project generated files
cache/
generated_pdfs/

# Secrets
credentials.json
token.pickle

service-account.json
chatbot/service-account.json
chatbot/mcp_server/service-account.json

# Additional Python Virtual Environments
venv/
.venv/
env/

# Logs & Debugging Files
# NOTE: do NOT reinstate a blanket `*.txt` rule here. It silently excluded the
# interview service's requirements.txt, which is why that file was missing.
*.log
azure_findings.txt
events_out.txt
uv_log.txt

# OS & IDEs
.DS_Store
.idea/
.gemini/

# ── Front-end builds ──
build/
dist/

# ── Expert-chat uploads (keep the directory, drop the contents) ──
expert-chat/uploads/*
!expert-chat/uploads/.gitkeep

# ── Interview service generated artefacts ──
interview/faiss_index/
interview/resume_cache/

# NOTE: the `cache/` rule above is intentionally broad but has a sharp edge —
# it also matches venv/Lib/site-packages/langgraph/cache/, which is why the
# committed venv could not import langgraph. Untrack venv/ before narrowing it.

# Evaluation output
eval-report.json
